<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <ModName>ScriptedScreensVector</ModName>
        <AssemblyName>$(ModName)</AssemblyName>
        <RootNamespace>$(ModName)</RootNamespace>
        <TargetFramework>netstandard2.1</TargetFramework>
        <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
        <Version>0.10.2.0</Version>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    </PropertyGroup>
    <!-- Build paths and the Documents-directory override live in exactly one
         place: Stationeers.VS.User.props at the repo root. Copy the .example
         beside it and edit that; it is gitignored. -->
    <Import Project="..\Stationeers.VS.props" />
    <Import Project="..\Stationeers.VS.References.props" />
    <PropertyGroup>
        <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
        <AssemblyVersion>$(Version)</AssemblyVersion>
        <FileVersion>$(Version)</FileVersion>
        <!-- CA1031: mod load must never throw into the host.
             CA1812: Unity instantiates MonoBehaviours and Harmony calls patch classes
             reflectively, neither of which the analyzer can see. -->
        <NoWarn>$(NoWarn);CA1031;CA1812</NoWarn>
        <ScriptedScreensDirectory>$(SteamLibraryDirectory)\..\workshop\content\$(StationeersSteamAppId)\3666779631</ScriptedScreensDirectory>
    </PropertyGroup>
    <Target Name="EnsureScriptedScreensDll" BeforeTargets="ResolveAssemblyReferences">
        <Error Text="ScriptedScreens.dll not found at $(ScriptedScreensDirectory). Subscribe to the workshop item or set ScriptedScreensDirectory."
               Condition="!Exists('$(ScriptedScreensDirectory)\ScriptedScreens.dll')" />
    </Target>
    <ItemGroup>
        <!-- ScriptedScreensScriptableUiSystem and every type we touch are internal, so the
             reference has to be publicised. IgnoresAccessChecksTo does NOT work here:
             Roslyn does not honour it at compile time. Publicising is build-time only;
             the shipped DLL is never modified. -->
        <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.3" PrivateAssets="all" />
        <Reference Include="ScriptedScreens" Publicize="true">
            <HintPath>$(ScriptedScreensDirectory)\ScriptedScreens.dll</HintPath>
            <Private>False</Private>
        </Reference>
        <Reference Include="StationeersMods.Interface">
            <HintPath>$(StationeersLaunchPadDirectory)\StationeersMods.Interface.dll</HintPath>
            <Private>False</Private>
        </Reference>
    </ItemGroup>
    <ItemGroup>
        <CopyItemsAbout Include="$(ProjectDir)\About\**\*.*" />
        <CopyItemsExamples Include="$(ProjectDir)\examples\**\*.lua" />
        <CopyItemsDocs Include="$(ProjectDir)\README.md;$(ProjectDir)\REFERENCE.md;$(ProjectDir)\Patterns.lua" />
    </ItemGroup>
    <Target Name="CopyAssetsToMods" AfterTargets="PostBuild">
        <Copy SourceFiles="@(CopyItemsAbout)" DestinationFolder="$(StationeersDocumentsDirectory)\mods\$(ModName)\About\%(RecursiveDir)" ContinueOnError="true" />
        <Copy SourceFiles="@(CopyItemsExamples)" DestinationFolder="$(StationeersDocumentsDirectory)\mods\$(ModName)\examples\%(RecursiveDir)" ContinueOnError="true" />
        <Copy SourceFiles="@(CopyItemsDocs)" DestinationFolder="$(StationeersDocumentsDirectory)\mods\$(ModName)" ContinueOnError="true" />
    </Target>
    <Target Name="GenerateVersionConst" BeforeTargets="CoreCompile">
        <PropertyGroup>
            <_VersionConstFile>$(IntermediateOutputPath)PluginVersionConst.g.cs</_VersionConstFile>
        </PropertyGroup>
        <WriteLinesToFile File="$(_VersionConstFile)" Overwrite="true" Lines="namespace $(RootNamespace) { internal static partial class PluginInfo { internal const string PLUGIN_VERSION_CONST = %22$(Version)%22%3B } }" />
        <ItemGroup>
            <Compile Include="$(_VersionConstFile)" />
        </ItemGroup>
    </Target>
</Project>
